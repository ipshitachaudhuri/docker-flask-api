global:
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'ipshita.eee@gmail.com'
  smtp_auth_username: 'ipshita.eee@gmail.com'
  smtp_auth_password: 'PASTE_YOUR_NEW_APP_PASSWORD_HERE'

route:
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h
  receiver: 'email-alerts'

receivers:
- name: 'email-alerts'
  email_configs:
  - to: 'ipshita.eee@gmail.com'
    send_resolved: true
